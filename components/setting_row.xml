<!-- 设置列表行：Screen 传入图标、标题和值，交互由页面 Controller 绑定。
     箭头固定在右侧，数值标签独立命名（row_value）；
     row_fill 为编辑态底纹，宽度由控制器设置（默认 0 不可见），位于最底层。 -->
<component>
	<api>
		<prop name="icon" type="image" default="setting_default" />
		<prop name="title" type="string" default="设置项" />
		<prop name="value" type="string" default="" />
	</api>
	<view extends="lv_button" width="100%" height="44" style_text_font="cjk_sc_16">
		<style name="style_settings_row" />
		<style name="style_settings_row_focused" selector="focused" />
		<lv_obj
			name="row_fill"
			width="0"
			height="100%"
			align="left_mid"
			style_radius="6"
			style_bg_color="0xff72b6"
			style_bg_opa="35%"
			style_border_width="0"
		/>
		<lv_image src="$icon" width="32" height="32" inner_align="contain" align="left_mid" />
		<lv_label text="$title" x="42" align="left_mid" style_text_font="cjk_sc_16" style_text_color="0xffffff" />
		<lv_label name="row_arrow" text="›" align="right_mid" style_text_font="cjk_sc_16" style_text_color="0xbfc1c7" />
		<lv_label
			name="row_value"
			text="$value"
			align="right_mid"
			x="-16"
			style_text_font="cjk_sc_16"
			style_text_color="0xbfc1c7"
		/>
	</view>
</component>
