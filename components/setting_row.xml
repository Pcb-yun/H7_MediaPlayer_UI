<!-- 设置列表行：Screen 传入图标、标题和值，交互由页面 Controller 绑定。 -->
<component>
	<api>
		<prop name="icon" type="image" default="NULL" />
		<prop name="title" type="string" default="设置项" />
		<prop name="value" type="string" default="›" />
	</api>
	<view extends="lv_button" width="100%" height="44" style_text_font="cjk_sc_14">
		<style name="style_settings_row" />
		<style name="style_settings_row_focused" selector="focused" />
		<lv_image src="$icon" width="26" height="26" inner_align="contain" align="left_mid" />
		<lv_label text="$title" x="38" align="left_mid" style_text_font="cjk_sc_14" style_text_color="0xffffff" />
		<lv_label text="$value" align="right_mid" style_text_font="cjk_sc_14" style_text_color="0xbfc1c7" />
	</view>
</component>
