<globals>
	<api>
		<!-- Add <enumdefs> here -->
	</api>

	<consts>
		<!-- Add <px>, <int>, <color> etc here -->
	</consts>

	<subjects>
		<!-- Add <int>, <string>, or <float> subjects here -->
	</subjects>

	<images>
		<!-- Add <file> or <data> tags here -->
		<!-- 背景图片 -->
		<data name="ahq" color_format="rgb565" src_path="images/backgrounds/ahq.png" />
		<data name="bochi" color_format="rgb565" src_path="images/backgrounds/bochi.png" />

		<!-- 图标图片（30x30） -->
		<data name="mute" color_format="rgb565a8" src_path="images/icons/mute-30.png" />
		<data name="next" color_format="rgb565a8" src_path="images/icons/next-30.png" />
		<data name="pause" color_format="rgb565a8" src_path="images/icons/pause-30.png" />
		<data name="play" color_format="rgb565a8" src_path="images/icons/play-30.png" />
		<data name="playlist" color_format="rgb565a8" src_path="images/icons/playlist-30.png" />
		<data name="power" color_format="rgb565a8" src_path="images/icons/power-30.png" />
		<data name="prev" color_format="rgb565a8" src_path="images/icons/previous-30.png" />
		<data name="queue" color_format="rgb565a8" src_path="images/icons/queue-30.png" />
		<data name="repeat" color_format="rgb565a8" src_path="images/icons/repeat-30.png" />
		<data name="repeat_one" color_format="rgb565a8" src_path="images/icons/repeat-one-30.png" />
		<data name="shuffle" color_format="rgb565a8" src_path="images/icons/shuffle-30.png" />
		<data name="volume_high" color_format="rgb565a8" src_path="images/icons/volume-high-30.png" />
		<data name="volume_low" color_format="rgb565a8" src_path="images/icons/volume-low-30.png" />

		<!-- 应用选择器图标（96x96，透明背景）。-->
		<data name="app_settings" color_format="rgb565a8" src_path="images/apps/app-settings.png" />
		<data name="app_music" color_format="rgb565a8" src_path="images/apps/app-music.png" />
		<data name="app_files" color_format="rgb565a8" src_path="images/apps/app-files.png" />
		<data name="app_photos" color_format="rgb565a8" src_path="images/apps/app-photos.png" />
		<data name="app_video" color_format="rgb565a8" src_path="images/apps/app-video.png" />
		<data name="app_camera" color_format="rgb565a8" src_path="images/apps/app-camera.png" />
		<data name="app_system_monitor" color_format="rgb565a8" src_path="images/apps/app-system-monitor.png" />

		<!-- 设置应用列表图标（96x96 透明 PNG，在列表中缩放为 26x26）。 -->
		<data name="setting_brightness" color_format="rgb565a8" src_path="images/settings/setting-brightness.png" />
		<data name="setting_orientation" color_format="rgb565a8" src_path="images/settings/setting-orientation.png" />
		<data name="setting_reboot" color_format="rgb565a8" src_path="images/settings/setting-reboot.png" />
		<data name="setting_local_update" color_format="rgb565a8" src_path="images/settings/setting-local-update.png" />
		<data name="setting_about" color_format="rgb565a8" src_path="images/settings/setting-about.png" />
	</images>

	<fonts>
		<!-- 10px lvgl默认字体 -->
		<bin
			name="montserrat_10"
			src_path="fonts/Montserrat-Medium.ttf"
			size="10"
			bpp="4"
			range="0x20-0x7F"
			as_file="false"
		/>

		<!-- 中日文字体 -->
		<bin
			name="cjk_sc_14"
			src_path="fonts/SourceHanSansCN-Regular.ttf"
			size="14"
			bpp="2"
			range="0x20-0x7F,0x3000-0x303F,0x3040-0x30FF,0x4E00-0x9FFF,0xFF00-0xFFEF"
			as_file="false"
		/>
		<bin
			name="cjk_jp_14"
			src_path="fonts/NotoSansJP-Regular.ttf"
			size="14"
			bpp="2"
			range="0x20-0x7F,0x3000-0x303F,0x3040-0x30FF,0x4E00-0x9FFF,0xFF00-0xFFEF"
			as_file="false"
		/>

		<!-- 图标位图字体 -->
		<bin
			name="icon_14"
			src_path="fonts/FontAwesome5-Solid+Brands+Regular.ttf"
			size="14"
			bpp="4"
			range="0xF000-0xF8FF"
			as_file="false"
		/>
	</fonts>

	<styles>
		<!-- 应用选择器磁贴的公共外观 -->
		<style
			name="style_launcher_tile"
			help="应用选择器磁贴：深色半透明圆角块 + 浅灰描边"
			radius="16"
			bg_color="0x111827"
			bg_opa="65%"
			border_width="1"
			border_color="0xe5e7eb"
			border_opa="40%"
		/>
		<!-- 磁贴聚焦态：粉色外描边 + 光晕 -->
		<style
			name="style_launcher_tile_focused"
			help="应用选择器磁贴选中态：粉色描边与光晕"
			outline_width="3"
			outline_color="0xff72b6"
			outline_opa="100%"
			shadow_width="10"
			shadow_color="0xff4fa3"
			shadow_opa="60%"
		/>

		<!-- 设置列表项：焦点态只改变背景与左侧强调色，适合旋钮逐项浏览。 -->
		<style
			name="style_settings_row"
			radius="8"
			bg_color="0x161616"
			bg_opa="100%"
			border_width="0"
			pad_left="10"
			pad_right="10"
		/>
		<style
			name="style_settings_row_focused"
			bg_color="0x29212a"
			outline_width="2"
			outline_color="0xff72b6"
			outline_opa="100%"
		/>
	</styles>
</globals>
