<!-- launcher.xml - 应用选择器（每页 2 列网格）。磁贴用 launcher_tile 组件描述；
     页面数与每页应用数由 C 侧按应用总数计算，增删应用时同步增删本文件的磁贴与分页点即可。 -->
<screen>
	<view
		style_text_font="cjk_sc_16"
		style_pad_all="0"
		style_bg_color="0x000000"
		style_bg_opa="100%"
		style_bg_image_src="bochi"
		style_bg_image_tiled="false"
	>
		<!-- 仅应用选择器使用暗化层。 -->
		<lv_obj
			name="launcher_scrim"
			width="100%"
			height="100%"
			style_bg_color="0x111827"
			style_bg_opa="45%"
			style_border_width="0"
		/>

		<!-- 第一页：设置、音乐、文件、图片。2 列网格，间距 24/10，左右留边 16。 -->
		<lv_obj
			name="launcher_page_0"
			width="100%"
			height="100%"
			flex_flow="row_wrap"
			style_pad_left="16"
			style_pad_right="16"
			style_pad_top="14"
			style_pad_column="24"
			style_pad_row="10"
			style_bg_opa="0"
			style_border_width="0"
		>
			<launcher_tile name="launcher_tile_0" icon="app_settings" label="设置" />
			<launcher_tile name="launcher_tile_1" icon="app_music" label="音乐" />
			<launcher_tile name="launcher_tile_2" icon="app_files" label="文件" />
			<launcher_tile name="launcher_tile_3" icon="app_photos" label="图片" />
		</lv_obj>

		<!-- 第二页：视频、相机、系统监视器。初始可见性由 C 侧 page_update() 设置，XML 不写 hidden。 -->
		<lv_obj
			name="launcher_page_1"
			width="100%"
			height="100%"
			flex_flow="row_wrap"
			style_pad_left="16"
			style_pad_right="16"
			style_pad_top="14"
			style_pad_column="24"
			style_pad_row="10"
			style_bg_opa="0"
			style_border_width="0"
		>
			<launcher_tile name="launcher_tile_4" icon="app_video" label="视频" />
			<launcher_tile name="launcher_tile_5" icon="app_camera" label="相机" />
			<launcher_tile name="launcher_tile_6" icon="app_system_monitor" label="监视器" />
		</lv_obj>

		<!-- 分页指示：单容器 + 每页一个点，当前页由 C 侧切换样式。增加页面时在此追加一个 launcher_dot_N。 -->
		<lv_obj
			name="launcher_dots"
			align="bottom_mid"
			y="-8"
			width="28"
			height="6"
			style_pad_all="0"
			style_bg_opa="0"
			style_border_width="0"
		>
			<lv_obj name="launcher_dot_0" x="0" y="0">
				<style name="style_page_dot" />
			</lv_obj>
			<lv_obj name="launcher_dot_1" x="16" y="0">
				<style name="style_page_dot" />
			</lv_obj>
		</lv_obj>
	</view>
</screen>
