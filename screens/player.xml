<!-- player.xml - 播放器主界面（布局待重建）。
     编码器交互约定：导航态旋转 = 组内焦点遍历（电源→播放列表→音量→上一曲→播放/暂停→下一曲→循环模式），
     遍历到底再滚由焦点回绕检测切屏（多控件屏组内自动回绕，edge_cb 不触发，见 H7_MediaPlayer_UI.c）；
     按下 = 触发该控件点击：音量键会展开音量条并进入调节态（此刻旋转 = 调音量），再次按下收起。
     音量条逻辑在 H7_MediaPlayer_UI.c 中实现（手动切换焦点组编辑态 + LV_EVENT_KEY 收旋转）。
     注意：本屏至少保留一个可聚焦控件，否则编码器无法移动焦点，边界切屏也不会触发 -->
<screen>
	<view
		style_text_font="cjk_sc_14"
		style_pad_all="10"
		style_bg_color="0xffffff"
		style_bg_opa="100%"
		style_bg_image_src="ahq"
		style_bg_image_tiled="false"
	>
		<!-- 顶部状态栏：电源（左）、播放列表（右）。与控制栏同为满宽 + space_between，
		     所以电源左边与音量左边对齐，播放列表右边与循环模式右边对齐 -->
		<lv_obj
			name="top_bar"
			align="top_mid"
			width="100%"
			height="content"
			flex_flow="row"
			style_flex_main_place="space_between"
			style_flex_cross_place="center"
			style_flex_track_place="center"
			style_pad_all="0"
			style_bg_opa="0"
			style_bg_image_src=""
			style_bg_image_tiled="false"
			style_border_width="0"
		>
			<!-- 电源：关机/待机，点击逻辑待接入 -->
			<lv_button
				name="btn_power"
				width="30"
				height="30"
				style_radius="8"
				style_bg_color="0xe5e7eb"
				style_bg_opa="60%"
				style_border_width="0"
				style_shadow_width="0"
				style_border_width-focused="2"
				style_border_color-focused="0xff72b6"
			>
				<lv_image src="power" />
			</lv_button>

			<!-- 播放列表：打开播放列表，点击逻辑待接入 -->
			<lv_button
				name="btn_playlist"
				width="30"
				height="30"
				style_radius="8"
				style_bg_color="0xe5e7eb"
				style_bg_opa="60%"
				style_border_width="0"
				style_shadow_width="0"
				style_border_width-focused="2"
				style_border_color-focused="0xff72b6"
			>
				<lv_image src="playlist" />
			</lv_button>
		</lv_obj>

		<!-- 曲目信息：歌名 + 艺术家，文本由 H7_MediaPlayer_UI.c 在切歌后刷新。
		     长度固定为两行（长模式 dots，靠 100% 宽度做省略号截断），避免中文标题把版面顶乱。
		     半透明底：与按钮同款浅灰 70% + 圆角 8，内边距 4 让文字不贴边；
		     无标签的曲目两行都是空串，C 侧会把整个框隐藏，免得只剩一条空底 -->
		<lv_obj
			name="meta_box"
			align="top_mid"
			y="35"
			width="100%"
			height="content"
			flex_flow="column"
			style_flex_main_place="center"
			style_flex_cross_place="center"
			style_flex_track_place="center"
			style_pad_all="4"
			style_pad_row="0"
			style_radius="8"
			style_bg_color="0xe5e7eb"
			style_bg_opa="70%"
			style_bg_image_src=""
			style_bg_image_tiled="false"
			style_border_width="0"
		>
			<lv_label
				name="meta_title"
				text=""
				width="100%"
				long_mode="dots"
				style_text_align="center"
				style_text_font="cjk_sc_14"
				style_text_color="0x000000"
			/>
			<lv_label
				name="meta_artist"
				text=""
				width="100%"
				long_mode="dots"
				style_text_align="center"
				style_text_font="cjk_sc_14"
				style_text_color="0x4b5563"
			/>
		</lv_obj>

		<!-- 歌词框：原词 + 翻译两行，文本由 H7_MediaPlayer_UI.c 按当前播放位置刷新。
		     高度固定 80（去掉内边距 12 后内容区 68，可容 3 行 12px 中文），不被长句撑开；
		     纵向 flex 居中，短歌词在框内居中。背景与按钮同款浅灰 70% + 圆角 8。
		     两行同字号(12)，靠颜色区分主次；中日文由 C 侧换成预烘焙的位图字体（假名走日文，其余走简体）。
		     位置介于曲目信息(约 44 到 88)与进度行(约 178 起)之间，上下各留 4 到 6 像素 -->
		<lv_obj
			name="lyric_box"
			align="top_mid"
			width="100%"
			height="93"
			flex_flow="column"
			style_flex_main_place="center"
			style_flex_cross_place="center"
			style_flex_track_place="center"
			style_pad_all="6"
			style_pad_row="2"
			style_radius="8"
			style_bg_color="0xe5e7eb"
			style_bg_opa="70%"
			style_bg_image_src=""
			style_bg_image_tiled="false"
			style_border_width="0"
			x="0"
			y="82"
		>
			<lv_label
				name="lyric_main"
				text=""
				width="100%"
				long_mode="wrap"
				style_text_align="center"
				style_text_font="cjk_sc_14"
				style_text_color="0x0f172a"
			/>
			<lv_label
				name="lyric_tras"
				text=""
				width="100%"
				long_mode="wrap"
				style_text_align="center"
				style_text_font="cjk_sc_14"
				style_text_color="0x64748b"
				recolor="false"
			/>
		</lv_obj>

		<!-- 进度行：贴在控制栏正上方，左侧进度条随剩余宽度拉伸，右侧显示 已播时间 / 总时间。
		     y 偏移 = -(控制栏高 30 + 间距 6)，控制栏尺寸变了要同步调 -->
		<lv_obj
			name="progress_row"
			align="bottom_mid"
			y="-27"
			width="100%"
			height="content"
			flex_flow="row"
			style_flex_cross_place="center"
			style_pad_all="0"
			style_pad_column="6"
			style_bg_opa="0"
			style_bg_image_src=""
			style_bg_image_tiled="false"
			style_border_width="0"
		>
			<!-- 进度轨道：可聚焦组件，flex_grow 占满剩余宽度，内部填充按播放百分比拉伸。
			     按下进入"时间调整"态（此时不seek），调整态下旋钮转动才真正发seek请求，逻辑在 H7_MediaPlayer_UI.c。
			     聚焦用 outline（画在控件外侧、不占内容区），这样聚焦前后填充条高度不变、不会跳动 -->
			<lv_button
				name="progress_track"
				flex_grow="1"
				height="6"
				style_radius="3"
				style_bg_color="0xe5e7eb"
				style_bg_opa="100%"
				style_border_width="0"
				style_pad_all="0"
				style_shadow_width="0"
				style_outline_width="2"
				style_outline_color="0xff72b6"
				style_outline_pad="1"
				style_outline_opa="0"
				style_outline_opa-focused="100%"
				width="158"
			>
				<lv_obj
					name="progress_fill"
					width="0"
					height="100%"
					align="left_mid"
					style_radius="3"
					style_bg_color="0xff72b6"
					style_bg_opa="100%"
					style_border_width="0"
				/>
			</lv_button>

			<!-- 播放时间：剩余时间（-MM:SS），播放结束归零显示 00:00，文本由 H7_MediaPlayer_UI.c 刷新。
			     固定宽度 + 右对齐：数字宽度不等，若宽度自适应，左侧进度条会随时间数字长短伸缩；
			     宽度按最宽文本（-88:88 ≈ 53 px）取，只留少量余量，剩下的宽度都给进度条，
			     固定宽度还能让时间右端始终与控制栏右端对齐 -->
			<lv_label
				name="progress_time"
				text="-00:00"
				width="47"
				style_text_align="right"
				style_text_font="cjk_sc_14"
				style_text_color="0x000000"
				height="20"
			/>
		</lv_obj>

		<!-- 底部控制栏：音量 | 上一曲 | 播放/暂停 | 下一曲 | 循环模式。
		     满宽 + space_between：两端分别与上方进度条左端、总时间右端对齐，点击逻辑在 H7_MediaPlayer_UI.c -->
		<lv_obj
			name="ctrl_bar"
			align="bottom_mid"
			width="100%"
			height="content"
			flex_flow="row"
			style_flex_main_place="space_between"
			style_flex_cross_place="center"
			style_flex_track_place="center"
			style_pad_all="0"
			style_bg_opa="0"
			style_bg_image_src=""
			style_bg_image_tiled="false"
			style_border_width="0"
		>
			<!-- 音量按钮：图标随音量在 mute（0）/ volume_low / volume_high（≥50）间切换；
			     按下展开上方音量条并转入调节态，展开期间旋转调音量。图标切换与调节逻辑在 H7_MediaPlayer_UI.c -->
			<lv_button
				name="btn_volume"
				width="30"
				height="30"
				style_radius="8"
				style_bg_color="0xe5e7eb"
				style_bg_opa="60%"
				style_border_width="0"
				style_shadow_width="0"
				style_border_width-focused="2"
				style_border_color-focused="0xff72b6"
			>
				<lv_image src="volume_high" />
			</lv_button>

			<lv_button
				name="btn_prev"
				width="30"
				height="30"
				style_radius="8"
				style_bg_color="0xe5e7eb"
				style_bg_opa="60%"
				style_border_width="0"
				style_shadow_width="0"
				style_border_width-focused="2"
				style_border_color-focused="0xff72b6"
			>
				<lv_image src="prev" />
			</lv_button>

			<!-- 播放/暂停：pause=正在播放，play=已暂停，按下切换 -->
			<lv_button
				name="btn_playpause"
				width="30"
				height="30"
				style_radius="8"
				style_bg_color="0xe5e7eb"
				style_bg_opa="60%"
				style_border_width="0"
				style_shadow_width="0"
				style_border_width-focused="2"
				style_border_color-focused="0xff72b6"
			>
				<lv_image name="icon_playstate" src="pause" />
			</lv_button>

			<lv_button
				name="btn_next"
				width="30"
				height="30"
				style_radius="8"
				style_bg_color="0xe5e7eb"
				style_bg_opa="60%"
				style_border_width="0"
				style_shadow_width="0"
				style_border_width-focused="2"
				style_border_color-focused="0xff72b6"
			>
				<lv_image src="next" />
			</lv_button>

			<!-- 循环模式：queue 列表顺序 → repeat 列表循环 → repeat_one 单曲循环 → shuffle 随机，点击循环切换 -->
			<lv_button
				name="btn_repeat"
				width="30"
				height="30"
				style_radius="8"
				style_bg_color="0xe5e7eb"
				style_bg_opa="60%"
				style_border_width="0"
				style_shadow_width="0"
				style_border_width-focused="2"
				style_border_color-focused="0xff72b6"
			>
				<lv_image name="icon_repeat" src="queue" />
			</lv_button>
		</lv_obj>

		<!-- 音量条：音量键按下时向上展开，屏幕内绝对定位在音量键正上方。
		     外框 30x80 半透明描边，纵向 flex 靠底排：上方填充条随音量涨落，最下方显示音量数字。
		     注意：默认隐藏、禁用滚动条、以及数字高度占用的空间扣除，统一在 H7_MediaPlayer_UI.c 的 bind 里处理
		     （XML 里写 hidden/scrollable 会让编辑器生成已弃用的 lv_obj_set_flag） -->
		<lv_obj
			name="volume_popup"
			width="30"
			height="85"
			align="bottom_left"
			x="0"
			y="-32"
			flex_flow="column"
			style_flex_main_place="end"
			style_flex_cross_place="center"
			style_flex_track_place="center"
			style_radius="8"
			style_bg_color="0xffffff"
			style_bg_opa="40%"
			style_border_width="2"
			style_border_color="0xff72b6"
			style_border_opa="50%"
			style_pad_all="0"
		>
			<!-- 音量填充：紧贴数字上方，高度由音量决定（在 flex 末尾之前的项，故位于数字上方） -->
			<lv_obj
				name="volume_fill"
				width="20"
				height="0"
				style_radius="4"
				style_bg_color="0xff72b6"
				style_bg_opa="100%"
				style_border_width="0"
			/>
			<!-- 音量数值：始终贴在最下方，文本由 H7_MediaPlayer_UI.c 刷新 -->
			<lv_label name="volume_value" style_text_font="cjk_sc_14" style_text_color="0x000000" />
		</lv_obj>
	</view>
</screen>
