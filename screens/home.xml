<!-- home.xml - 主页面：两个主题框居中排列，下方剩余空间放仿 Win10 的灰色圆点加载动画 -->
<screen>
	<animations>
		<!-- 每个圆点一条独立轨迹，都绕同一个圆心（各自容器的中心）转，时间各错开 180ms。
		     基准曲线（0.1° 单位，周期 3480ms 走 720° = 两圈，快慢速度比 1 : 0.225，即快速 4.44 倍）：
		       S1 [0,270]      0°→120°    快 0.444°/ms
		       S2 [270,1470]   120°→240°  慢 0.10°/ms
		       S3 [1470,1740]  240°→360°  快 0.444°/ms
		       S4 [1740,2010]  360°→480°  快（第二圈重复）
		       S5 [2010,3210]  480°→600°  慢 0.10°/ms
		       S6 [3210,3480]  600°→720°  快 0.444°/ms
		     错开 180ms 后：慢段相邻点间距 18°（半径 26 时弧长 8.2px，大于相邻两点半径之和 6.5px，
		     留 1.7px 间隙），快段 80°，整个队形最大铺开 320°（小于 360°，首尾还差 40°）。
		     比值不能无限拉大：比值 ≤（360° − 首尾余量）÷（4 × 所需间距角），而所需间距角由点的大小决定，
		     所以点越小，允许的比值越高（现在是 7/6/5/4/3 px → 18°→ 4.44 倍）。
		     错开的点还要补一条“前导段”（上周期尾部折回来的负角度），保证周期切换时角度差正好 720°（视觉无跳变）。
		     同一属性的多段动画必须写 early_apply="false"，否则没轮到的那段会不断刷自己的 start 值。 -->
		<timeline name="timeline_spin" repeat_count="infinite">
			<!-- dot_0：基准轨迹，不错开 -->
			<animation
				prop="transform_rotation"
				target="dot_0"
				start="0"
				end="1200"
				duration="270"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_0"
				start="1200"
				end="2400"
				duration="1200"
				delay="270"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_0"
				start="2400"
				end="3600"
				duration="270"
				delay="1470"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_0"
				start="3600"
				end="4800"
				duration="270"
				delay="1740"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_0"
				start="4800"
				end="6000"
				duration="1200"
				delay="2010"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_0"
				start="6000"
				end="7200"
				duration="270"
				delay="3210"
				early_apply="false"
			/>
			<!-- dot_1：错开 180ms -->
			<animation
				prop="transform_rotation"
				target="dot_1"
				start="-800"
				end="0"
				duration="180"
				early_apply="false"
			/>
			<!-- 前导段 -->
			<animation
				prop="transform_rotation"
				target="dot_1"
				start="0"
				end="1200"
				duration="270"
				delay="180"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_1"
				start="1200"
				end="2400"
				duration="1200"
				delay="450"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_1"
				start="2400"
				end="3600"
				duration="270"
				delay="1650"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_1"
				start="3600"
				end="4800"
				duration="270"
				delay="1920"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_1"
				start="4800"
				end="6000"
				duration="1200"
				delay="2190"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_1"
				start="6000"
				end="6400"
				duration="90"
				delay="3390"
				early_apply="false"
			/>
			<!-- 末段按周期截断 -->
			<!-- dot_2：错开 360ms -->
			<animation
				prop="transform_rotation"
				target="dot_2"
				start="-1290"
				end="-1200"
				duration="90"
				early_apply="false"
			/>
			<!-- 前导段前半 -->
			<animation
				prop="transform_rotation"
				target="dot_2"
				start="-1200"
				end="0"
				duration="270"
				delay="90"
				early_apply="false"
			/>
			<!-- 前导段后半 -->
			<animation
				prop="transform_rotation"
				target="dot_2"
				start="0"
				end="1200"
				duration="270"
				delay="360"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_2"
				start="1200"
				end="2400"
				duration="1200"
				delay="630"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_2"
				start="2400"
				end="3600"
				duration="270"
				delay="1830"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_2"
				start="3600"
				end="4800"
				duration="270"
				delay="2100"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_2"
				start="4800"
				end="5910"
				duration="1110"
				delay="2370"
				early_apply="false"
			/>
			<!-- dot_3：错开 540ms -->
			<animation
				prop="transform_rotation"
				target="dot_3"
				start="-1470"
				end="-1200"
				duration="270"
				early_apply="false"
			/>
			<!-- 前导段前半 -->
			<animation
				prop="transform_rotation"
				target="dot_3"
				start="-1200"
				end="0"
				duration="270"
				delay="270"
				early_apply="false"
			/>
			<!-- 前导段后半 -->
			<animation
				prop="transform_rotation"
				target="dot_3"
				start="0"
				end="1200"
				duration="270"
				delay="540"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_3"
				start="1200"
				end="2400"
				duration="1200"
				delay="810"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_3"
				start="2400"
				end="3600"
				duration="270"
				delay="2010"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_3"
				start="3600"
				end="4800"
				duration="270"
				delay="2280"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_3"
				start="4800"
				end="5730"
				duration="930"
				delay="2550"
				early_apply="false"
			/>
			<!-- dot_4：错开 720ms -->
			<animation
				prop="transform_rotation"
				target="dot_4"
				start="-1650"
				end="-1200"
				duration="450"
				early_apply="false"
			/>
			<!-- 前导段前半 -->
			<animation
				prop="transform_rotation"
				target="dot_4"
				start="-1200"
				end="0"
				duration="270"
				delay="450"
				early_apply="false"
			/>
			<!-- 前导段后半 -->
			<animation
				prop="transform_rotation"
				target="dot_4"
				start="0"
				end="1200"
				duration="270"
				delay="720"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_4"
				start="1200"
				end="2400"
				duration="1200"
				delay="990"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_4"
				start="2400"
				end="3600"
				duration="270"
				delay="2190"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_4"
				start="3600"
				end="4800"
				duration="270"
				delay="2460"
				early_apply="false"
			/>
			<animation
				prop="transform_rotation"
				target="dot_4"
				start="4800"
				end="5550"
				duration="750"
				delay="2730"
				early_apply="false"
			/>
			<!-- 调试进度条填充宽度：匀速填满，每 1740ms（正好一圈 360°）从 0 填到 200px 再清空，
			     所以它只按“一圈”为周期，不跟随圆点的快慢变化 -->
			<animation prop="width" target="bar_fill" start="0" end="200" duration="1740" early_apply="false" />
			<animation
				prop="width"
				target="bar_fill"
				start="0"
				end="200"
				duration="1740"
				delay="1740"
				early_apply="false"
			/>
			<!-- 第二圈：清空后重新匀速填 -->
		</timeline>
	</animations>

	<styles>
		<!-- 主题框：80% 宽的半透明卡片，蓝色描边圆角，内部横向居中 -->
		<style
			name="style_box"
			width="80%"
			height="content"
			flex_flow="row"
			flex_main_place="center"
			flex_cross_place="center"
			flex_track_place="center"
			pad_all="10"
			radius="10"
			bg_color="0xf1f5f9"
			bg_opa="50%"
			border_width="2"
			border_color="0x3b82f6"
		/>
		<!-- 圆点：灰色，radius 取 4 保证最大的 7px 圆点仍是正圆 -->
		<style name="style_dot" radius="4" bg_color="0x9ca3af" bg_opa="100%" />
	</styles>

	<view
		flex_flow="column"
		style_flex_main_place="center"
		style_flex_cross_place="center"
		style_flex_track_place="center"
		style_pad_all="12"
		style_pad_row="10"
		style_bg_color="0xffffff"
		style_bg_opa="100%"
		style_bg_image_src="ahq"
		style_bg_image_tiled="false"
	>
		<!-- 屏幕加载完成后开始播放追逐动画 -->
		<play_timeline_event target="self" timeline="timeline_spin" trigger="screen_loaded" reverse="false" />

		<lv_obj>
			<style name="style_box" />
			<lv_label text="H7_MediaPlayer" width="100%" style_text_align="center" style_text_color="0x000000" />
			<!-- 第一行：黑色 -->
		</lv_obj>

		<lv_obj>
			<style name="style_box" />
			<lv_label text="Hello LVGL editor" width="100%" style_text_align="center" style_text_color="0x0000ff" />
			<!-- 第二行：蓝色 -->
		</lv_obj>

		<!-- 下方剩余空间：撑满剩余高度。5 个点各放在一个 64x64 的透明容器里，全部 align="center"
		     同心叠放，容器基准点设在中心（32,32），所以每个容器各自绕圆心转，互不影响 -->
		<lv_obj flex_grow="1" width="100%" style_bg_opa="0" style_bg_image_src="" style_bg_image_tiled="false">
			<!-- 每个点都摆在 12 点方向、半径 26 处（y=-26），角度差由各自的轨迹错开产生 -->
			<lv_obj
				name="dot_0"
				width="64"
				height="64"
				align="center"
				style_bg_opa="0"
				style_transform_pivot_x="32"
				style_transform_pivot_y="32"
			>
				<lv_obj width="7" height="7" align="center" y="-26">
					<style name="style_dot" />
				</lv_obj>
				<!-- 领头：7px -->
			</lv_obj>
			<lv_obj
				name="dot_1"
				width="64"
				height="64"
				align="center"
				style_bg_opa="0"
				style_transform_pivot_x="32"
				style_transform_pivot_y="32"
			>
				<lv_obj width="6" height="6" align="center" y="-26">
					<style name="style_dot" />
				</lv_obj>
				<!-- 6px -->
			</lv_obj>
			<lv_obj
				name="dot_2"
				width="64"
				height="64"
				align="center"
				style_bg_opa="0"
				style_transform_pivot_x="32"
				style_transform_pivot_y="32"
			>
				<lv_obj width="5" height="5" align="center" y="-26">
					<style name="style_dot" />
				</lv_obj>
				<!-- 5px -->
			</lv_obj>
			<lv_obj
				name="dot_3"
				width="64"
				height="64"
				align="center"
				style_bg_opa="0"
				style_transform_pivot_x="32"
				style_transform_pivot_y="32"
			>
				<lv_obj width="4" height="4" align="center" y="-26">
					<style name="style_dot" />
				</lv_obj>
				<!-- 4px -->
			</lv_obj>
			<lv_obj
				name="dot_4"
				width="64"
				height="64"
				align="center"
				style_bg_opa="0"
				style_transform_pivot_x="32"
				style_transform_pivot_y="32"
			>
				<lv_obj width="3" height="3" align="center" y="-26">
					<style name="style_dot" />
				</lv_obj>
				<!-- 3px -->
			</lv_obj>
		</lv_obj>

		<!-- 底部调试进度条：浅灰轨道 + 蓝色填充，每转完一圈（360°）刚好填满，然后清空重来 -->
		<lv_obj width="200" height="6" style_radius="3" style_bg_color="0xe5e7eb" style_bg_opa="100%">
			<lv_obj
				name="bar_fill"
				width="0"
				height="4"
				style_radius="2"
				align="left_mid"
				style_bg_color="0x3b82f6"
				style_bg_opa="100%"
			/>
		</lv_obj>
	</view>
</screen>
