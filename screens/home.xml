<!-- home.xml - 背景主页面：时间、日期与 Wi-Fi 状态。透明全屏按钮承接旋钮短按。 -->
<screen>
	<view
		style_text_font="cjk_sc_16"
		style_pad_all="0"
		style_bg_color="0xffffff"
		style_bg_opa="100%"
		style_bg_image_src="bochi"
		style_bg_image_tiled="false"
	>
		<!-- 大号时间：文本由后续 C 侧按分钟刷新。 -->
		<lv_label
			name="home_time"
			text="21:35"
			x="10"
			y="12"
			width="132"
			height="52"
			style_text_font="home_time_44"
			style_text_color="0xffffff"
			style_text_opa="100%"
		/>

		<!-- 日期与星期共用一行，保持主画面简洁。 -->
		<lv_label
			name="home_date"
			text="9月26日  周六"
			x="11"
			y="66"
			width="132"
			height="20"
			style_text_font="cjk_sc_16"
			style_text_color="0xffffff"
			style_text_opa="95%"
		/>

		<!-- Wi-Fi 状态胶囊：使用嵌入式 PNG，保证 Editor 预览与固件显示一致。 -->
		<lv_obj
			name="home_wifi_pill"
			align="top_right"
			x="-8"
			y="10"
			width="84"
			height="32"
			flex_flow="row"
			style_flex_main_place="center"
			style_flex_cross_place="center"
			style_flex_track_place="center"
			style_pad_all="0"
			style_pad_column="4"
			style_radius="16"
			style_bg_color="0x111827"
			style_bg_opa="75%"
			style_border_width="1"
			style_border_color="0xffffff"
			style_border_opa="50%"
		>
			<lv_image
				name="home_wifi_icon"
				src="wifi_off"
				width="18"
				height="18"
				inner_align="contain"
				style_image_opa="100%"
			/>
			<lv_label name="home_wifi_state" text="已关闭" style_text_font="cjk_sc_16" style_text_color="0xffffff" />
		</lv_obj>

		<!-- 保留可聚焦按钮，确保编码器点按能进入应用选择器。所有视觉属性均透明。 -->
		<lv_button
			name="text_focus"
			width="100%"
			height="100%"
			x="0"
			y="0"
			style_pad_all="0"
			style_bg_opa="0"
			style_border_width="0"
			style_shadow_width="0"
			style_outline_width="0"
			style_outline_opa="0"
		/>
	</view>
</screen>
