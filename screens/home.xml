<!-- home.xml - 纯背景主页面。透明全屏按钮仅承接旋钮短按，不产生任何视觉叠加。 -->
<screen>
	<view
		style_pad_all="0"
		style_bg_color="0xffffff"
		style_bg_opa="100%"
		style_bg_image_src="bochi"
		style_bg_image_tiled="false"
	>
		<!-- 保留可聚焦按钮，确保编码器点按能进入应用选择器。所有视觉属性均透明。 -->
		<lv_button
			name="text_focus"
			width="100%"
			height="100%"
			x="0"
			y="0"
			style_pad_all="0"
			style_bg_opa="0"
			style_border_width="0"
			style_shadow_width="0"
			style_outline_width="0"
			style_outline_opa="0"
		/>
	</view>
</screen>
