<!-- 关于页面：每个信息栏都是可聚焦 Component，列表可继续纵向扩展。 -->
<screen>
	<view style_text_font="cjk_sc_14" style_pad_all="0" style_bg_color="0x080808" style_bg_opa="100%">
		<page_header name="about_header" x="0" y="0" title="关于" />
		<lv_obj
			name="about_list"
			x="0"
			y="34"
			width="100%"
			height="206"
			flex_flow="column"
			style_pad_left="8"
			style_pad_right="8"
			style_pad_top="6"
			style_pad_bottom="10"
			style_pad_row="6"
			style_bg_opa="0"
			style_border_width="0"
		>
			<lv_button
				name="about_intro"
				width="100%"
				height="content"
				flex_flow="row"
				style_flex_cross_place="center"
				style_pad_all="10"
				style_pad_column="10"
			>
				<style name="style_settings_row" />
				<style name="style_settings_row_focused" selector="focused" />
				<lv_image src="app_settings" width="38" height="38" inner_align="contain" />
				<lv_label
					width="148"
					height="content"
					text="基于 H7 的多媒体玩具"
					long_mode="wrap"
					style_text_font="cjk_sc_14"
					style_text_color="0xf3f4f6"
				/>
			</lv_button>
			<info_row
				name="about_repository"
				title="仓库"
				value="github.com/Pcb-yun/H7_MediaPlayer_Apps"
				value_name="about_repository_value"
			/>
			<info_row name="about_version_row" title="固件版本" value="v0.1.0" value_name="about_firmware_version" />
			<info_row
				name="about_build_row"
				title="编译时间"
				value="MMM DD YYYY HH:MM:SS"
				value_name="about_build_time"
			/>
		</lv_obj>
	</view>
</screen>
